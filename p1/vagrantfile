Vagrant.configure("2") do |config|

  config.vm.box = "generic/ubuntu2204"
  config.vm.synced_folder "./shared", "/vagrant_shared", type: "9p", disabled: false

  config.vm.define "iargenceS" do |server|
    server.vm.hostname = "iargenceS"
    server.vm.network "private_network", ip: "192.168.56.110"

    server.vm.provider :libvirt do |lv|
      lv.memory = 2048
      lv.cpus = 1
      lv.nested = true
    end

    server.vm.provision "shell", path: "scripts/server.sh"
  end

  config.vm.define "iargenceSW" do |worker|
    worker.vm.hostname = "iargenceSW"
    worker.vm.network "private_network", ip: "192.168.56.111"

    worker.vm.provider :libvirt do |lv|
      lv.memory = 1024
      lv.cpus = 1
      lv.nested = true
    end

    worker.vm.provision "shell", path: "scripts/worker.sh"
  end

end
